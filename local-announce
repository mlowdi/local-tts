#!/bin/sh
set -eu

script=$0
while [ -L "$script" ]; do
    directory=$(CDPATH= cd -- "$(dirname -- "$script")" && pwd -P)
    target=$(readlink -- "$script")
    case $target in
        /*) script=$target ;;
        *) script=$directory/$target ;;
    esac
done
directory=$(CDPATH= cd -- "$(dirname -- "$script")" && pwd -P)
exec "$directory/.venv/bin/python" "$directory/announce.py" "$@"
